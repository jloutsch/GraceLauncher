<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Requested only when the user explicitly enables local contact search. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Ordinary permission for the opt-in Lab status-bar API path; no accessibility access. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Hidden profiles are accessible only while Grace holds the default HOME role. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Actual widget binding is still granted by the user through Android's bind UI. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <!-- Some OEM clocks, including Samsung's, protect SHOW_ALARMS with this permission. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="org.breezyweather.READ_PROVIDER" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <package android:name="org.breezyweather" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GraceLauncher"
        tools:targetApi="33">
        <!-- The official Breezy notifier requires an exported receiver and defines no
             sender permission. Payloads are ignored; signals only coalesce a read of
             the permission-protected, package-verified provider while enabled. -->
        <receiver
            android:name=".platform.BreezyWeatherUpdateReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.breezyweather.ACTION_UPDATE_NOTIFIER" />
            </intent-filter>
        </receiver>
        <!-- GenericWeather senders discover this exported receiver. Data is accepted only
             in Gadgetbridge mode and decoded with bounded input before caching locally. -->
        <receiver
            android:name=".platform.GadgetbridgeWeatherReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="nodomain.freeyourgadget.gadgetbridge.ACTION_GENERIC_WEATHER" />
            </intent-filter>
        </receiver>
        <!-- Explicit, user-authorized lock-screen and system-panel actions only. -->
        <service
            android:name=".platform.GraceAccessibilityService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/grace_accessibility_service" />
        </service>
        <!-- System-managed binding for app notification previews and media sessions. -->
        <service
            android:name=".data.media.MediaNotificationListener"
            android:label="@string/media_service_name"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/Theme.GraceLauncher.Home"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PinItemActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.GraceLauncher.Settings">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WidgetSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.GraceLauncher.Settings" />
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/grace_settings"
            android:theme="@style/Theme.GraceLauncher.Settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
